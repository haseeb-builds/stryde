# Stryde Vercel runtime environment contract
#
# Set these in Vercel Project Settings → Environment Variables (Preview + Production).
# Do NOT put real values in this file. Local development uses .env.local (gitignored).
#
# ── Required for the app to function ─────────────────────────────────────────
# Supabase (public project ref pvijrnwdnolvnoibarrj):
NEXT_PUBLIC_SUPABASE_URL=            # https://pvijrnwdnolvnoibarrj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon key (client-side; RLS applies)
SUPABASE_SECRET_KEY=                 # service key (server-only; trusted plane RPCs)
#
# Public site URL (canonical URLs, check-in links):
NEXT_PUBLIC_SITE_URL=                # e.g. https://stryde.vercel.app
#
# Model path — production chain is gemini → openrouter → omniroute.
#
# STATUS 2026-10-03 (measured, not assumed):
#   gemini     works, but the free tier allows 20 requests/day. Verified live
#              (both contracts PASSED) and then quota-exhausted the same day.
#              Enable billing to lift the cap, or accept the ceiling.
#   openrouter  the adapter is provider-neutral and ready, but the key available
#              in this environment returns HTTP 402 on every paid model
#              (free-tier account, no credits) and the `:free` slugs now 404.
#              Add credits and this becomes the production primary.
#   omniroute   MUST be excluded in production. It is a tailnet-only local
#              address and is unreachable from Vercel.
#
# Minimum viable production: fund EITHER openrouter OR gemini billing, and set
#   STRYDE_PROVIDER_DISABLED=omniroute
# so production never depends on local infrastructure. A provider outage must
# degrade to an honest 503 with the last persisted working state, never to a
# fabricated next move.
STRYDE_GEMINI_API_KEY=               # optional once a funded provider exists
# Optional Gemini tuning:
# STRYDE_GEMINI_MODEL=gemini-flash-latest
# STRYDE_GEMINI_THINKING_BUDGET=0
#
# Chain control:
#   Production MUST contain STRYDE_PROVIDER_DISABLED=omniroute.
#   STRYDE_MODEL_PROVIDER only reorders the chain; it never removes a leg.
#   STRYDE_PROVIDER_DISABLED is the only removal mechanism.
STRYDE_PROVIDER_DISABLED=omniroute
STRYDE_MODEL_PROVIDER=               # optional preferred-first leg reorder
STRYDE_MODEL_TIMEOUT_MS=45000
STRYDE_MODEL_RETRY_BASE_DELAY_MS=750
#
# ── Optional capability keys (features degrade gracefully without them) ─────
EXA_API_KEY=                         # internal autonomous web research
FIRECRAWL_API_KEY=                   # URL ingestion / source extraction
RESEND_API_KEY=                      # check-in reminder emails
#
# ── Worker plane (only if running scripts/worker-dispatcher.ts somewhere) ────
# STRYDE_WORKER_SECRET=              # required by /api/internal/* worker routes
# STRYDE_WORKER_POLL_MS / STRYDE_WORKER_LEASE_SECONDS / STRYDE_WORKER_ONCE
#
# A real agent-backed worker (npm run worker:hermes) satisfies the
# lib/worker-gateway.ts HTTP contract with real Hermes one-shot runs:
#   STRYDE_HERMES_URL=                # dispatcher target, e.g. http://127.0.0.1:8899
#   STRYDE_HERMES_BIN=                # path to the hermes executable
#   STRYDE_HERMES_MODEL=              # build-time model for the agent
#   STRYDE_HERMES_TIMEOUT_MS=240000   # a run killed at its budget is UNKNOWN
#   STRYDE_HERMES_ENV_FILE=           # agent's own env file (never returned in results)
#
# NOTE: this is a LOCAL worker target. Production must not depend on it; point
# STRYDE_HERMES_URL at a real worker service instead.
#
# Never expose SUPABASE_SECRET_KEY, STRYDE_GEMINI_API_KEY, EXA_API_KEY,
# FIRECRAWL_API_KEY, RESEND_API_KEY, or STRYDE_WORKER_SECRET to the client.
